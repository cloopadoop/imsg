<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="WinIMsg.App.Controls.ChatListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Grid
                Margin="10,10,10,8"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
                <TextBox
                    x:Name="ChatSearchBox"
                    PlaceholderText="Search chats and messages"
                    TextChanged="OnSearchTextChanged" />
                <ToggleButton
                    x:Name="SelectChatsButton"
                    Grid.Column="1"
                    Checked="OnSelectChatsChecked"
                    Style="{StaticResource ToolbarToggleButton}"
                    Unchecked="OnSelectChatsUnchecked"
                    ToolTipService.ToolTip="Select conversations">
                    <FontIcon FontSize="16" Glyph="&#xE762;" />
                </ToggleButton>
                <Button
                    x:Name="NewChatButton"
                    Grid.Column="2"
                    Click="OnNewChatClicked"
                    Style="{StaticResource ToolbarButton}"
                    ToolTipService.ToolTip="New message">
                    <SymbolIcon Symbol="Edit" />
                </Button>
            </Grid>
            <TextBlock
                x:Name="ChatSearchStatusTextBlock"
                Grid.Row="1"
                Margin="12,0,12,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
            <Grid
                x:Name="MassActionBar"
                Grid.Row="2"
                Margin="10,0,10,8"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MassActionCountTextBlock"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0 selected"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="MassSelectAllButton"
                    Grid.Column="1"
                    Click="OnMassSelectAllClicked"
                    Content="Select all" />
                <Button
                    x:Name="MassMarkReadButton"
                    Grid.Column="2"
                    Click="OnMassMarkReadClicked"
                    Content="Mark read"
                    IsEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
            <ListView
                x:Name="ChatListView"
                Grid.Row="3"
                SelectionChanged="OnChatSelectionChanged"
                IsItemClickEnabled="True"
                ItemClick="OnChatItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Background="{Binding RowBackgroundBrush}"
                            Padding="12,8"
                            ColumnDefinitions="Auto,Auto,*,Auto"
                            ColumnSpacing="8"
                            RowDefinitions="Auto,Auto">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnOpenChatMenuClicked"
                                        Tag="{Binding}"
                                        Text="Open" />
                                    <MenuFlyoutItem
                                        Click="OnRefreshChatMenuClicked"
                                        Tag="{Binding}"
                                        Text="Refresh conversation" />
                                    <MenuFlyoutItem
                                        Click="OnMarkChatReadMenuClicked"
                                        Tag="{Binding}"
                                        Text="Mark read" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="OnCopyChatNameMenuClicked"
                                        Tag="{Binding}"
                                        Text="Copy name" />
                                    <MenuFlyoutItem
                                        Click="OnCopyChatAddressMenuClicked"
                                        Tag="{Binding}"
                                        Text="Copy address" />
                                    <MenuFlyoutItem
                                        Click="OnCopyChatGuidMenuClicked"
                                        Tag="{Binding}"
                                        Text="Copy chat GUID" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid
                                Grid.RowSpan="2"
                                Width="8"
                                VerticalAlignment="Stretch">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding UnreadDotVisibility}" />
                            </Grid>
                            <Border
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{Binding AvatarBackgroundBrush}"
                                CornerRadius="18">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{Binding AvatarText}" />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                FontWeight="{Binding TitleFontWeight}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="12"
                                FontWeight="{Binding DetailFontWeight}"
                                Foreground="{Binding TimestampBrush}"
                                Text="{Binding TimestampText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                FontWeight="{Binding DetailFontWeight}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Detail}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
