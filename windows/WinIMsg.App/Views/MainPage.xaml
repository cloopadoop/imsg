<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WinIMsg.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinIMsg.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/MessagesTray.ico"
            LeftClickCommand="{x:Bind TrayOpenCommand}"
            MenuActivation="RightClick"
            NoLeftClickDelay="True"
            ToolTipText="iMessage for Windows">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind TrayOpenCommand}"
                        Text="Open" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{x:Bind TrayExitCommand}"
                        Text="Exit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button
                    x:Name="ConnectionStatusIcon"
                    VerticalAlignment="Center"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Disconnected">
                    <Grid Width="14" Height="14">
                        <Ellipse
                            x:Name="ConnectionStatusDot"
                            Fill="{ThemeResource TextFillColorDisabledBrush}"
                            Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="320" Spacing="8">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Activity" />
                                <ListView
                                    x:Name="StatusTaskListView"
                                    MaxHeight="320"
                                    IsItemClickEnabled="False"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding}"
                                                TextWrapping="WrapWholeWords" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock
                    x:Name="StatusTextBlock"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Disconnected"
                    Visibility="Collapsed" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ComboBox
                        x:Name="ProfilePicker"
                        Width="180"
                        Height="32"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        SelectionChanged="OnProfileSelectionChanged"
                        SelectedValuePath="Id"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="RefreshButton"
                        VerticalAlignment="Center"
                        Click="OnRefreshClicked"
                        Style="{StaticResource ToolbarButton}"
                        ToolTipService.ToolTip="Refresh chats">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        VerticalAlignment="Center"
                        Click="OnSettingsClicked"
                        Style="{StaticResource ToolbarButton}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="0"
            VerticalAlignment="Bottom"
            Height="18"
            IsHitTestVisible="False">
            <ProgressBar
                x:Name="CacheSyncProgressBar"
                Height="2"
                VerticalAlignment="Bottom"
                Maximum="100"
                Minimum="0"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="CacheSyncInlineTextBlock"
                MaxWidth="460"
                Margin="14,0,14,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
        </Grid>

        <Grid
            x:Name="ConversationShellGrid"
            Grid.Row="1"
            ColumnDefinitions="330,6,*">
            <controls:ChatListPane
                x:Name="ChatListPane"
                ChatContextCopyAddressRequested="OnChatContextCopyAddressRequested"
                ChatContextCopyGuidRequested="OnChatContextCopyGuidRequested"
                ChatContextCopyNameRequested="OnChatContextCopyNameRequested"
                ChatContextMarkReadRequested="OnChatContextMarkReadRequested"
                ChatContextOpenRequested="OnChatContextOpenRequested"
                ChatContextRefreshRequested="OnChatContextRefreshRequested"
                ChatItemClick="OnChatClicked"
                MassMarkReadRequested="OnChatMassMarkReadRequested"
                NewChatRequested="OnNewChatClicked"
                SearchTextChanged="OnChatSearchTextChanged" />

            <controls:CursorGrid
                x:Name="ConversationSplitter"
                Grid.Column="1"
                Background="Transparent"
                PointerCanceled="OnConversationSplitterPointerReleased"
                PointerEntered="OnConversationSplitterPointerEntered"
                PointerExited="OnConversationSplitterPointerExited"
                PointerMoved="OnConversationSplitterPointerMoved"
                PointerPressed="OnConversationSplitterPointerPressed"
                PointerReleased="OnConversationSplitterPointerReleased">
                <Border
                    x:Name="ConversationSplitterLine"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    Opacity="0.55" />
            </controls:CursorGrid>

            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="SelectedChatTextBlock"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Conversation.Title}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Conversation.TitleVisibility}" />
                            <StackPanel
                                MaxWidth="700"
                                Visibility="{Binding Conversation.DraftHeaderVisibility}">
                                <ScrollViewer
                                    Margin="0,0,0,6"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    Visibility="{Binding Conversation.DraftRecipientChipsVisibility}">
                                    <ItemsControl ItemsSource="{Binding Conversation.DraftRecipientChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="8,4"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid
                                                        MaxWidth="320"
                                                        ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="6">
                                                        <TextBlock
                                                            MinWidth="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Text="{Binding}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Click="OnDraftRecipientChipRemoveClicked"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ToolbarButton}"
                                                            ToolTipService.ToolTip="Remove recipient">
                                                            <FontIcon
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Glyph="&#xE711;" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="To:" />
                                    <AutoSuggestBox
                                        x:Name="DraftRecipientsInputBox"
                                        Grid.Column="1"
                                        MinWidth="260"
                                        MaxWidth="640"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="Name, phone, or email"
                                        QuerySubmitted="OnDraftRecipientQuerySubmitted"
                                        SuggestionChosen="OnDraftRecipientSuggestionChosen"
                                        TextChanged="OnDraftRecipientsTextChanged" />
                                </Grid>
                            </StackPanel>
                            <TextBlock
                                x:Name="InlineStatusTextBlock"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Conversation.InlineStatus}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Conversation.InlineStatusVisibility}" />
                        </StackPanel>
                        <Button
                            x:Name="ChatActionsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarButton}"
                            ToolTipService.ToolTip="Conversation actions">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Name="MarkReadMenuItem"
                                        Click="OnMarkReadClicked"
                                        Text="Mark read" />
                                    <MenuFlyoutItem
                                        x:Name="MarkUnreadMenuItem"
                                        Click="OnMarkUnreadClicked"
                                        Text="Mark unread" />
                                    <MenuFlyoutItem
                                        x:Name="FaceTimeLinkMenuItem"
                                        Click="OnFaceTimeLinkClicked"
                                        Text="Create FaceTime link" />
                                    <MenuFlyoutItem
                                        x:Name="DeleteChatMenuItem"
                                        Click="OnDeleteChatClicked"
                                        Text="Delete conversation..." />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="RenameGroupMenuItem"
                                        Click="OnRenameGroupClicked"
                                        Text="Rename group..." />
                                    <MenuFlyoutItem
                                        x:Name="SetGroupIconMenuItem"
                                        Click="OnSetGroupIconClicked"
                                        Text="Set group icon..." />
                                    <MenuFlyoutItem
                                        x:Name="ClearGroupIconMenuItem"
                                        Click="OnClearGroupIconClicked"
                                        Text="Clear group icon" />
                                    <MenuFlyoutItem
                                        x:Name="AddParticipantMenuItem"
                                        Click="OnAddParticipantClicked"
                                        Text="Add participant..." />
                                    <MenuFlyoutItem
                                        x:Name="RemoveParticipantMenuItem"
                                        Click="OnRemoveParticipantClicked"
                                        Text="Remove participant..." />
                                    <MenuFlyoutItem
                                        x:Name="LeaveGroupMenuItem"
                                        Click="OnLeaveGroupClicked"
                                        Text="Leave group" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="MessageListView"
                        Padding="16"
                        SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <controls:MessageBubbleControl
                                    AttachmentOpenRequested="OnMessageAttachmentOpenRequested"
                                    DeleteRequested="OnMessageDeleteRequested"
                                    DownloadAttachmentRequested="OnMessageDownloadAttachmentRequested"
                                    EditRequested="OnMessageEditRequested"
                                    LinkOpenRequested="OnMessageLinkOpenRequested"
                                    Message="{Binding}"
                                    NotifyAnywaysRequested="OnMessageNotifyAnywaysRequested"
                                    OpenAttachmentRequested="OnMessageOpenAttachmentRequested"
                                    ReplyRequested="OnMessageReplyRequested"
                                    RetryAttachmentDownloadRequested="OnMessageRetryAttachmentDownloadRequested"
                                    RevealAttachmentRequested="OnMessageRevealAttachmentRequested"
                                    RetrySendRequested="OnMessageRetrySendRequested"
                                    TapbackRequested="OnMessageTapbackRequested"
                                    UnsendRequested="OnMessageUnsendRequested" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        x:Name="MessageLoadingPanel"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        Visibility="{Binding Conversation.LoadingVisibility}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <ProgressRing
                                x:Name="MessageProgressRing"
                                Width="36"
                                Height="36"
                                IsActive="{Binding Conversation.IsLoading}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Loading messages" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="JumpToLatestButton"
                        Margin="0,0,24,16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="OnJumpToLatestClicked"
                        Content="Jump to latest"
                        Visibility="Collapsed" />
                </Grid>

                <controls:ComposeBar
                    x:Name="ComposeBar"
                    Grid.Row="2"
                    AttachRequested="OnAttachClicked"
                    EmojiRequested="OnEmojiButtonClicked"
                    SendRequested="OnSendClicked"
                    VoiceRequested="OnVoiceButtonClicked" />
            </Grid>
        </Grid>

        <InfoBar
            x:Name="MacIMessageHealthInfoBar"
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            MaxWidth="720"
            IsClosable="True"
            IsOpen="False"
            Message="The Mac's iMessage authentication needs attention."
            Severity="Warning"
            Title="iMessage on the Mac needs attention">
            <InfoBar.ActionButton>
                <Button Content="Actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnMacHealthRetryClicked" Text="Retry connection" />
                            <MenuFlyoutItem Click="OnMacHealthDiagnosticsClicked" Text="Open diagnostics" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </InfoBar.ActionButton>
        </InfoBar>

        <Border
            x:Name="SettingsPage"
            Grid.Row="1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="24"
            Visibility="{Binding SettingsVisibility}">
            <Grid RowDefinitions="Auto,*" RowSpacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <Button
                        Grid.Column="1"
                        Click="OnCloseSettingsClicked"
                        Style="{StaticResource ToolbarButton}"
                        ToolTipService.ToolTip="Close settings">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="220,*"
                    ColumnSpacing="24">
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="0,0,16,0">
                        <ListView
                            x:Name="SettingsNavList"
                            SelectionChanged="OnSettingsNavChanged"
                            SelectionMode="Single">
                            <ListViewItem
                                Content="General"
                                Tag="General" />
                            <ListViewItem
                                Content="Profiles"
                                Tag="Profiles" />
                        </ListView>
                    </Border>

                    <Grid Grid.Column="1">
                        <ScrollViewer
                            x:Name="GeneralSettingsPanel"
                            Visibility="Visible">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="14">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="General" />

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Windows" />
                                <CheckBox
                                    x:Name="AutoDownloadAttachmentsBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Auto-download attachments"
                                    IsChecked="True"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="MinimizeToTrayBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Hide to tray when minimized or closed"
                                    IsChecked="True"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="StartWithWindowsBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Start with Windows"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="EnableNotificationsBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Show Windows notifications"
                                    IsChecked="True"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="ShowNotificationContentBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Show message contents in notifications"
                                    IsChecked="True"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="SendTypingIndicatorsBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Send typing indicators to recipients"
                                    IsChecked="False"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="EnableWebCompanionBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Enable web companion (localhost, for Ferdium or a browser)"
                                    IsChecked="False"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <TextBlock
                                    x:Name="WebCompanionStatusTextBlock"
                                    Margin="28,0,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="Local cache" />
                                <CheckBox
                                    x:Name="BackgroundCacheSyncBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Sync all chats in the background after connecting"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <CheckBox
                                    x:Name="MergeChatsByParticipantsBox"
                                    Checked="OnGeneralSettingsChanged"
                                    Content="Merge duplicate chats with the same participants"
                                    IsChecked="True"
                                    Unchecked="OnGeneralSettingsChanged" />
                                <ComboBox
                                    x:Name="PhoneNumberRegionBox"
                                    Width="360"
                                    MaxDropDownHeight="420"
                                    DisplayMemberPath="Label"
                                    Header="Phone region for local numbers"
                                    HorizontalContentAlignment="Stretch"
                                    PlaceholderText="Auto detect"
                                    SelectedValuePath="Code"
                                    SelectionChanged="OnGeneralSettingsSelectionChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SyncCacheButton"
                                        Click="OnSyncCacheClicked"
                                        Content="Sync now" />
                                    <Button
                                        x:Name="ClearCacheButton"
                                        Click="OnClearCacheClicked"
                                        Content="Clear local cache" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="CacheSyncStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="Contacts" />
                                <TextBlock
                                    x:Name="ContactNamesTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="CheckContactsButton"
                                        Click="OnCheckContactsClicked"
                                        Content="Check contact names" />
                                    <Button
                                        x:Name="PromptMacPermissionsButton"
                                        Click="OnPromptMacPermissionsClicked"
                                        Content="Prompt Mac permissions" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="Diagnostics" />
                                <TextBlock
                                    x:Name="SetupChecklistTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="RunSetupChecklistButton"
                                        Click="OnRunSetupChecklistClicked"
                                        Content="Run setup checklist" />
                                    <Button
                                        x:Name="ExportSupportBundleButton"
                                        Click="OnExportSupportBundleClicked"
                                        Content="Export support bundle" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="LogPathTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="OpenLogButton"
                                        Click="OnOpenLogClicked"
                                        Content="Open log" />
                                    <Button
                                        x:Name="OpenLogsFolderButton"
                                        Click="OnOpenLogsFolderClicked"
                                        Content="Open logs folder" />
                                </StackPanel>

                                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Advanced iMessage actions" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnAdvancedInstructionsClicked"
                                        Style="{StaticResource ToolbarButton}"
                                        ToolTipService.ToolTip="Open setup instructions">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            Glyph="&#xE8A7;" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    x:Name="AdvancedFeatureTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="Capability matrix" />
                                <TextBlock
                                    x:Name="CapabilityMatrixSummaryTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                                <Grid
                                    ColumnDefinitions="92,150,118,*"
                                    ColumnSpacing="8"
                                    Padding="8,4,8,0">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Area" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Feature" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Status" />
                                    <TextBlock
                                        Grid.Column="3"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Methods and setup" />
                                </Grid>
                                <ItemsControl x:Name="CapabilityMatrixItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="8"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <Grid ColumnDefinitions="92,150,118,*" ColumnSpacing="8">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Text="{Binding Category}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Text="{Binding Feature}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="12"
                                                        Text="{Binding Status}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <StackPanel
                                                        Grid.Column="3"
                                                        Spacing="2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding Methods}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Guidance}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SaveGeneralButton"
                                        Click="OnSaveGeneralClicked"
                                        Content="Save"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="OnCancelSettingsClicked"
                                        Content="Cancel" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid
                            x:Name="ProfilesSettingsPanel"
                            RowDefinitions="Auto,*"
                            RowSpacing="12"
                            Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="Profiles" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Choose a Mac profile to edit or connect." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="OnAddProfileClicked"
                                    Content="Add profile" />
                            </Grid>

                            <ListView
                                x:Name="ProfileListView"
                                Grid.Row="1"
                                IsItemClickEnabled="True"
                                ItemClick="OnProfileListItemClicked"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10" RowDefinitions="Auto,Auto">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TargetSummary}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <ScrollViewer
                            x:Name="ProfileDetailPanel"
                            Visibility="Collapsed">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="12">
                                <Button
                                    Click="OnBackToProfilesClicked"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTipService.ToolTip="Back to profiles">
                                    <SymbolIcon Symbol="Back" />
                                </Button>
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Profile details" />
                                <TextBox
                                    x:Name="ProfileNameBox"
                                    Header="Profile name"
                                    PlaceholderText="Mac mini"
                                    TextChanged="OnProfileSettingsTextChanged" />
                                <TextBox
                                    x:Name="PrimaryTargetAddressBox"
                                    Header="Primary target address"
                                    PlaceholderText="test-mac.example.invalid"
                                    TextChanged="OnProfileSettingsTextChanged" />
                                <TextBox
                                    x:Name="FallbackTargetAddressesBox"
                                    AcceptsReturn="True"
                                    Header="Fallback target addresses"
                                    Height="86"
                                    PlaceholderText="192.0.2.10"
                                    TextChanged="OnProfileSettingsTextChanged"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="RemoteAccessModeBox"
                                    DisplayMemberPath="PickerLabel"
                                    Header="Remote access model"
                                    SelectedValuePath="Code"
                                    SelectionChanged="OnProfileSettingsSelectionChanged" />
                                <TextBlock
                                    x:Name="RemoteAccessStatusTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="UserBox"
                                    Header="User"
                                    PlaceholderText="testuser"
                                    TextChanged="OnProfileSettingsTextChanged" />
                                <NumberBox
                                    x:Name="PortBox"
                                    Header="SSH port"
                                    Maximum="65535"
                                    Minimum="1"
                                    SmallChange="1"
                                    ValueChanged="OnProfileSettingsNumberChanged"
                                    Value="22" />
                                <TextBox
                                    x:Name="IdentityFileBox"
                                    Header="Key"
                                    PlaceholderText="C:\Users\Test User\.ssh\id_ed25519"
                                    TextChanged="OnProfileSettingsTextChanged" />
                                <TextBox
                                    x:Name="ImsgPathBox"
                                    Header="imsg"
                                    Text="imsg"
                                    TextChanged="OnProfileSettingsTextChanged" />
                                <TextBox
                                    x:Name="RemoteAttachmentRootBox"
                                    Header="Mac attachment staging"
                                    Text="~/.win-imsg/attachments"
                                    TextChanged="OnProfileSettingsTextChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SaveProfileButton"
                                        Click="OnSaveProfileClicked"
                                        Content="Save"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="OnCancelSettingsClicked"
                                        Content="Cancel" />
                                    <Button
                                        x:Name="ConnectProfileButton"
                                        Click="OnConnectProfileClicked"
                                        Content="Connect" />
                                    <Button
                                        x:Name="DeleteProfileButton"
                                        Click="OnDeleteProfileClicked"
                                        Content="Delete profile" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="MediaOverlay"
            Grid.RowSpan="2"
            Background="#B8000000"
            Tapped="OnMediaOverlayBackgroundTapped"
            Visibility="Collapsed">
            <Border
                MaxWidth="980"
                MaxHeight="720"
                Margin="36"
                Padding="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                CornerRadius="8"
                Tapped="OnMediaOverlayContentTapped">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="MediaOverlayTitle"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="MediaOverlaySubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            x:Name="MediaOverlayOpenExternalButton"
                            Grid.Column="1"
                            Click="OnMediaOverlayOpenExternalClicked"
                            Content="Open externally" />
                        <Button
                            Grid.Column="2"
                            Click="OnMediaOverlayCloseClicked"
                            Style="{StaticResource ToolbarButton}"
                            ToolTipService.ToolTip="Close preview">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Image
                            x:Name="MediaOverlayImage"
                            MaxWidth="920"
                            MaxHeight="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <MediaPlayerElement
                            x:Name="MediaOverlayPlayer"
                            Width="900"
                            Height="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="MediaOverlayFilePanel"
                            Width="520"
                            Padding="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="32"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    x:Name="MediaOverlayFileText"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
